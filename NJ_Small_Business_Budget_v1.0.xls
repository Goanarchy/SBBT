<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Author>Google Antigravity Engineering</Author>
  <Title>NJ Small Business Budget &amp; Financial Control System v1.0</Title>
  <Company>Garden State Premier Solutions LLC</Company>
 </DocumentProperties>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Borders/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#0F172A"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
  <!-- Main Title -->
  <Style ss:ID="TitleStyle">
   <Font ss:FontName="Segoe UI" ss:Size="14" ss:Color="#1E3A8A" ss:Bold="1"/>
   <Alignment ss:Vertical="Center"/>
  </Style>
  <Style ss:ID="SubtitleStyle">
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#475569" ss:Italic="1"/>
   <Alignment ss:Vertical="Center"/>
  </Style>
  <!-- Table Header -->
  <Style ss:ID="HeaderStyle">
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#0F172A" ss:Pattern="Solid"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#334155"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#334155"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#334155"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#334155"/>
   </Borders>
  </Style>
  <Style ss:ID="HeaderFillable">
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#E0F2FE" ss:Bold="1"/>
   <Interior ss:Color="#0369A1" ss:Pattern="Solid"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#0284C7"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0284C7"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0284C7"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0284C7"/>
   </Borders>
  </Style>
  <!-- Fillable Input Cells (Soft Light Blue) -->
  <Style ss:ID="InputCellText">
   <Interior ss:Color="#E0F2FE" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#0369A1" ss:Bold="1"/>
  </Style>
  <Style ss:ID="InputCellCurrency">
   <Interior ss:Color="#E0F2FE" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#0369A1" ss:Bold="1"/>
   <NumberFormat ss:Format="&quot;$&quot;#,##0.00"/>
   <Alignment ss:Horizontal="Right" ss:Vertical="Center"/>
  </Style>
  <!-- Calculated Formula Cells -->
  <Style ss:ID="FormulaCell">
   <Interior ss:Color="#F8FAFC" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#0F172A" ss:Bold="1"/>
   <NumberFormat ss:Format="&quot;$&quot;#,##0.00"/>
   <Alignment ss:Horizontal="Right" ss:Vertical="Center"/>
  </Style>
  <Style ss:ID="FormulaCellGeneral">
   <Interior ss:Color="#F8FAFC" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#0F172A" ss:Bold="1"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
  </Style>
  <!-- Standard Regular Cell -->
  <Style ss:ID="StandardCell">
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <!-- Totals Row -->
  <Style ss:ID="TotalsLabel">
   <Interior ss:Color="#F1F5F9" ss:Pattern="Solid"/>
   <Font ss:FontName="Segoe UI" ss:Size="11" ss:Color="#0F172A" ss:Bold="1"/>
   <Borders>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#64748B"/>
    <Border ss:Position="Bottom" ss:LineStyle="Double" ss:Weight="3" ss:Color="#64748B"/>
   </Borders>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
  </Style>
  <Style ss:ID="TotalsCurrency">
   <Interior ss:Color="#F1F5F9" ss:Pattern="Solid"/>
   <Font ss:FontName="Segoe UI" ss:Size="11" ss:Color="#0F172A" ss:Bold="1"/>
   <NumberFormat ss:Format="&quot;$&quot;#,##0.00"/>
   <Alignment ss:Horizontal="Right" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#64748B"/>
    <Border ss:Position="Bottom" ss:LineStyle="Double" ss:Weight="3" ss:Color="#64748B"/>
   </Borders>
  </Style>
  <!-- Legend Styles -->
  <Style ss:ID="LegendFillable">
   <Interior ss:Color="#E0F2FE" ss:Pattern="Solid"/>
   <Font ss:FontName="Segoe UI" ss:Size="9" ss:Color="#0369A1" ss:Bold="1"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#7DD3FC"/>
   </Borders>
  </Style>
  <Style ss:ID="LegendFormula">
   <Interior ss:Color="#F8FAFC" ss:Pattern="Solid"/>
   <Font ss:FontName="Segoe UI" ss:Size="9" ss:Color="#0F172A" ss:Bold="1"/>
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
   </Borders>
  </Style>
 </Styles>

 <!-- ========================================== -->
 <!-- TAB 1: EXECUTIVE SUMMARY                   -->
 <!-- ========================================== -->
 <Worksheet ss:Name="Executive Summary">
  <Table ss:DefaultColumnWidth="120" ss:DefaultRowHeight="20">
   <Column ss:Width="240"/>
   <Column ss:Width="160"/>
   <Column ss:Width="260"/>
   <Row ss:Height="26">
    <Cell ss:MergeAcross="2" ss:StyleID="TitleStyle"><Data ss:Type="String">GARDEN STATE FINANCIAL CONTROL SYSTEM - EXECUTIVE DASHBOARD</Data></Cell>
   </Row>
   <Row>
    <Cell ss:MergeAcross="2" ss:StyleID="SubtitleStyle"><Data ss:Type="String">Operating in New Jersey, USA | Fiscal Year 2025 | Currency: USD ($)</Data></Cell>
   </Row>
   <Row><Cell><Data ss:Type="String"></Data></Cell></Row>
   <Row>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Executive Metric / KPI</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Value</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Accounting Rationale &amp; NJ Context</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Total Gross Invoiced Revenue</Data></Cell>
    <Cell ss:StyleID="FormulaCell" ss:Formula="='Revenue &amp; Invoices'!R8C5"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Accrual billings before sales tax</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Total Cash Collected</Data></Cell>
    <Cell ss:StyleID="FormulaCell" ss:Formula="='Revenue &amp; Invoices'!R8C9"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Realized cash in operating bank account</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Direct COGS &amp; Materials</Data></Cell>
    <Cell ss:StyleID="FormulaCell" ss:Formula="='Direct COGS'!R8C6"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Direct materials, equipment rental, freight</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Gross Profit</Data></Cell>
    <Cell ss:StyleID="FormulaCell" ss:Formula="=R5C2-R7C2"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Gross Margin = Gross Revenue - Direct COGS</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Total Operating Expenses (OpEx)</Data></Cell>
    <Cell ss:StyleID="FormulaCell" ss:Formula="='Fleet &amp; Fuel'!R7C10+'Facility &amp; Mortgage'!R7C7+'Insurance Policies'!R7C7+'Payroll &amp; Labor'!R7C8+'Utilities &amp; Overhead'!R8C6"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Facility, Fleet, Payroll, Ins, Utilities</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="TotalsLabel"><Data ss:Type="String">NET OPERATING INCOME (EBIT)</Data></Cell>
    <Cell ss:StyleID="TotalsCurrency" ss:Formula="=R8C2-R9C2"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">True bottom line before corporate income taxes</Data></Cell>
   </Row>
   <Row><Cell><Data ss:Type="String"></Data></Cell></Row>
   <Row>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">NJ Tax Reserve Required</Data></Cell>
    <Cell ss:StyleID="FormulaCell" ss:Formula="='NJ Taxes &amp; Compliance'!R7C5"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Safe harbor statutory requirement (CBT + Sales Tax)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">NJ Tax Reserve Funded</Data></Cell>
    <Cell ss:StyleID="FormulaCell" ss:Formula="='NJ Taxes &amp; Compliance'!R7C6"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">Funds isolated in tax savings account</Data></Cell>
   </Row>
  </Table>
 </Worksheet>

 <!-- ========================================== -->
 <!-- TAB 2: REVENUE & INVOICES                  -->
 <!-- ========================================== -->
 <Worksheet ss:Name="Revenue &amp; Invoices">
  <Table ss:DefaultColumnWidth="105" ss:DefaultRowHeight="20">
   <Column ss:Width="90"/>
   <Column ss:Width="85"/>
   <Column ss:Width="160"/>
   <Column ss:Width="180"/>
   <Column ss:Width="110"/>
   <Column ss:Width="80"/>
   <Column ss:Width="110"/>
   <Column ss:Width="110"/>
   <Column ss:Width="110"/>
   <Column ss:Width="110"/>
   <Column ss:Width="100"/>
   <Column ss:Width="80"/>
   <Row ss:Height="24">
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Invoice #</Data></Cell>
    <Cell ss:StyleID="HeaderFillable"><Data ss:Type="String">Date [INPUT]</Data></Cell>
    <Cell ss:StyleID="HeaderFillable"><Data ss:Type="String">Client / Customer [INPUT]</Data></Cell>
    <Cell ss:StyleID="HeaderFillable"><Data ss:Type="String">Project Scope [INPUT]</Data></Cell>
    <Cell ss:StyleID="HeaderFillable"><Data ss:Type="String">Billed Amount ($) [INPUT]</Data></Cell>
    <Cell ss:StyleID="HeaderFillable"><Data ss:Type="String">NJ Taxable? [INPUT]</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">NJ Sales Tax (6.625%) [fx]</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Total Due ($) [fx]</Data></Cell>
    <Cell ss:StyleID="HeaderFillable"><Data ss:Type="String">Cash Collected ($) [INPUT]</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">AR Balance ($) [fx]</Data></Cell>
    <Cell ss:StyleID="HeaderFillable"><Data ss:Type="String">Payment Method [INPUT]</Data></Cell>
    <Cell ss:StyleID="HeaderFillable"><Data ss:Type="String">Status [INPUT]</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">INV-2025-01</Data></Cell>
    <Cell ss:StyleID="InputCellText"><Data ss:Type="String">2025-10-02</Data></Cell>
    <Cell ss:StyleID="InputCellText"><Data ss:Type="String">Horizon Healthcare NJ</Data></Cell>
    <Cell ss:StyleID="InputCellText"><Data ss:Type="String">Facility Smart Sensor Upgrades</Data></Cell>
    <Cell ss:StyleID="InputCellCurrency"><Data ss:Type="Number">14500.00</Data></Cell>
    <Cell ss:StyleID="InputCellText"><Data ss:Type="String">NO</Data></Cell>
    <Cell ss:StyleID="FormulaCell" ss:Formula="=IF(RC[-1]=&quot;YES&quot;, RC[-2]*0.06625, 0)"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="FormulaCell" ss:Formula="=RC[-3]+RC[-1]"><Data ss:Type="Number">14500.00</Data></Cell>
    <Cell ss:StyleID="InputCellCurrency"><Data ss:Type="Number">14500.00</Data></Cell>
    <Cell ss:StyleID="FormulaCell" ss:Formula="=RC[-2]-RC[-1]"><Data ss:Type="Number">0.00</Data></Cell>
    <Cell ss:StyleID="InputCellText"><Data ss:Type="String">ACH Transfer</Data></Cell>
    <Cell ss:StyleID="InputCellText"><Data ss:Type="String">Paid</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="StandardCell"><Data ss:Type="String">INV-2025-02</Data></Cell>
    <Cell ss:StyleID="InputCellText"><Data ss:Type="String">2025-10-08</Data></Cell>
    <Cell ss:StyleID="InputCellText"><Data ss:Type="String">Rutgers Innovation Lab</Data></Cell>
    <Cell ss:StyleID="InputCellText"><Data ss:Type="String">Custom Network Cabling &amp; Racks</Data></Cell>
    <Cell ss:StyleID="InputCellCurrency"><Data ss:Type="Number">21800.00</Data></Cell>
    <Cell ss:StyleID="InputCellText"><Data ss:Type="String">YES</Data></Cell>
