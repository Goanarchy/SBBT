  </Table>
 </Worksheet>

 <!-- ========================================== -->
 <!-- TAB 3: DIRECT COGS                         -->
 <!-- ========================================== -->
 <Worksheet ss:Name="Direct COGS">
  <Table ss:DefaultColumnWidth="120" ss:DefaultRowHeight="20">
   <Column ss:Width="100"/>
   <Column ss:Width="85"/>
   <Column ss:Width="180"/>
