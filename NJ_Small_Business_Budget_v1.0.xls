    <Cell ss:StyleID="FormulaCell" ss:Formula="=RC[-3]+RC[-1]"><Data ss:Type="Number">23244.25</Data></Cell>
    <Cell ss:StyleID="InputCellCurrency"><Data ss:Type="Number">21800.00</Data></Cell>
